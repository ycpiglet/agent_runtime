{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Users\\ycpig\\AppData\\Local\\Programs\\Python\\Python310\\python.exe scripts/session_baseline.py --root . --json",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "C:\\Users\\ycpig\\AppData\\Local\\Programs\\Python\\Python310\\python.exe scripts/session_dashboard.py --root .",
            "timeout": 35
          },
          {
            "type": "command",
            "command": "C:\\Users\\ycpig\\AppData\\Local\\Programs\\Python\\Python310\\python.exe scripts/claim_reaper_hook.py --root .",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "C:\\Users\\ycpig\\AppData\\Local\\Programs\\Python\\Python310\\python.exe scripts/interrupted_run_detector.py --root .",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts\\taskset_prompt_hook.cmd"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
