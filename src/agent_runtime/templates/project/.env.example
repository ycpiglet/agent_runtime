# Optional allimbot notifications. Export these into the process environment;
# the standard-library client does not parse .env files. Blank values disable
# delivery silently.
ALLIMBOT_URL=http://127.0.0.1:8787
ALLIMBOT_TOKEN=
ALLIMBOT_NTFY_TOPIC=
ALLIMBOT_PROVIDER=

# CI delivery additionally requires the repository variable
# ALLIMBOT_CI_NOTIFY_ENABLED=true and an ALLIMBOT_NTFY_TOPIC Actions secret.
