{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.local/schemas/planning-proposal.schema.json",
  "title": "Planning Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "mode",
    "status",
    "action_type",
    "risk_tier",
    "title",
    "dedupe_key",
    "source_refs",
    "evidence",
    "target_files",
    "rollback_path",
    "verifier_list",
    "owner_boundary"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^PROP-[A-Fa-f0-9]{12}$" },
    "mode": { "type": "string", "enum": ["B", "C"] },
    "status": {
      "type": "string",
      "enum": ["detected", "proposed", "under_review", "approved", "rejected", "applied", "superseded", "blocked"]
    },
    "action_type": {
      "type": "string",
      "enum": [
        "new_task",
        "plan_update",
        "doc_repair",
        "eval_expansion",
        "release_version_consistency",
        "retro_compound_follow_up",
        "watch_only",
        "c_mode_promotion"
      ]
    },
    "risk_tier": { "type": "string", "enum": ["low", "medium", "high", "owner"] },
    "title": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "trace_id": { "type": ["string", "null"] },
    "dedupe_key": { "type": "string", "minLength": 1 },
    "evidence_hash": { "type": "string" },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": true,
        "properties": {
          "path": { "type": "string" },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "kind": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["summary"],
        "additionalProperties": true,
        "properties": {
          "summary": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "severity": { "type": "string" }
        }
      }
    },
    "target_files": { "type": "array", "items": { "type": "string" } },
    "rollback_path": { "type": "string" },
    "verifier_list": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "owner_boundary": { "type": "string", "minLength": 1 },
    "department": { "type": "string" },
    "reviewer_opinions": { "type": "array", "items": { "type": "object" } },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "apply": { "type": "object" }
  }
}
